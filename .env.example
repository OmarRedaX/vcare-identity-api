# vcare identity-service — local environment (synthetic values only).
# Every variable is declared in src/lib/config/env.ts (CLAUDE.md -> Security rules).
# Secrets have no defaults; never commit a real value.

NODE_ENV=development

# Public listener (/api) and internal listener (/internal).
PORT=3000
INTERNAL_PORT=3100
# Bind address of the internal listener. Use 0.0.0.0 inside a container, 127.0.0.1 on a host.
INTERNAL_HOST=127.0.0.1
# Number of trusted proxy hops in front of the public listener (0 = no proxy).
TRUST_PROXY_HOPS=0

# SECRET — PostgreSQL connection string.
DATABASE_URL=postgres://identity:identity@localhost:5432/vcare_identity
DATABASE_POOL_MAX=10

# SECRET — Redis connection string (Tier 2: an outage never fails a request).
REDIS_URL=redis://localhost:6379

# Development only; production is a single origin with CORS disabled (hub ADR 0005).
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_FALLBACK_DIVISOR=2
WORKER_POLL_INTERVAL_MS=1000

# ── auth: tokens and one-time secrets (API process) ──────────────────────────
# SECRET — Ed25519 signing keys as a JSON array of { kid, privateJwk }; generate with
# `npm run keys:generate -- --kid identity-2026-09`. Never commit a real key.
JWT_PRIVATE_KEYS=[{"kid":"identity-local","privateJwk":{"kty":"OKP","crv":"Ed25519","d":"REPLACE_ME_43_CHAR_BASE64URL_PRIVATE_SCALAR_","x":"REPLACE_ME_43_CHAR_BASE64URL_PUBLIC_KEY_XXXX"}}]
# Which kid to sign with (defaults to the first entry above).
JWT_ACTIVE_KID=identity-local
# SECRET — HMAC key for registration and password-reset codes (min 32 characters).
OTP_PEPPER=local-development-otp-pepper-change-me
# Seconds a just-rotated refresh token is tolerated without revoking its family (ADR 0005).
REFRESH_REUSE_GRACE_SECONDS=10
# argon2id concurrency and queue bound; raise UV_THREADPOOL_SIZE alongside HASH_CONCURRENCY.
HASH_CONCURRENCY=4
HASH_QUEUE_MAX=50

# ── auth: worker process (outbox email delivery and purges) ──────────────────
WORKER_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
# Web client base URL used in email text only (no trailing slash).
APP_BASE_URL=http://localhost:5173
# `resend` (HTTPS provider) or `capture` (writes EMAIL_CAPTURE_DIR/outbox.jsonl; refused in production).
EMAIL_PROVIDER=capture
# SECRET — required only when EMAIL_PROVIDER=resend.
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_FROM=no-reply@example.test
EMAIL_PROVIDER_BASE_URL=https://api.resend.com
EMAIL_CAPTURE_DIR=.local/mail
