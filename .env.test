# Synthetic, local-only test values (committed). Real environment variables always win over this file.
# Local host instances (PostgreSQL 18 on 5432, Redis 8 on 6379) are used instead of the compose stack:
# role `identity`/`identity` owns `vcare_identity_test`; Redis database 1 is reserved for tests.
NODE_ENV=test
DATABASE_URL=postgres://identity:identity@localhost:5432/vcare_identity_test
REDIS_URL=redis://localhost:6379/1
LOG_LEVEL=warn
SHUTDOWN_TIMEOUT_MS=3000
# auth: the worker adapters used by tests and local QA. JWT_PRIVATE_KEYS, JWT_ACTIVE_KID and OTP_PEPPER are
# generated per run in tests/setup.ts when unset, so no key material is committed.
EMAIL_PROVIDER=capture
EMAIL_PROVIDER_FROM=no-reply@example.test
APP_BASE_URL=http://localhost:5173
EMAIL_CAPTURE_DIR=.local/mail-test
HASH_CONCURRENCY=2
